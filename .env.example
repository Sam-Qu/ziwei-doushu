# 复制为 .env.local 后填入实际值

# ─── MiniMax AI 解读（本仓库已补 /api/interpret）───
# 开源原版不含该路由；现用 MiniMax OpenAI 兼容接口做流式解读。
# 只想排盘、看命盘的话可以不填；点「AI 解读」时才需要。
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash

# ─── 可选：其他 OpenAI 兼容模型（当前 interpret 路由读的是上面 MiniMax 三项）───
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-deepseek-api-key
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点（生产填已备案域名，不要用 *.vercel.app 作微信回调）───
NEXT_PUBLIC_SITE_URL=https://your-icp-domain.example

# ─── 一期会员日限 + 微信扫码登录（/api/interpret）───
# 日限按 Asia/Shanghai 自然日：游客 2 次 / 已登录免费会员 20 次
# Upstash Redis（Vercel 集成或 https://upstash.com ）生产环境必配
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token
# 会话签名密钥（至少 16 字符）；生产必配
SESSION_SECRET=change-me-to-a-long-random-string

# 微信开放平台「网站应用」扫码登录（OAuth）
# 文档: https://developers.weixin.qq.com/doc/oplatform/developers/dev/auth/web.html
WECHAT_APP_ID=your-wechat-open-platform-appid
WECHAT_APP_SECRET=your-wechat-open-platform-appsecret
# 授权回调完整 URL，须与开放平台填写的授权回调域一致；不填则用 NEXT_PUBLIC_SITE_URL + /api/auth/wechat/callback
# WECHAT_REDIRECT_URI=https://your-icp-domain.example/api/auth/wechat/callback
