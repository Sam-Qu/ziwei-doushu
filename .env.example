# 复制为 .env.local 后填入实际值

# ─── MiniMax AI 解读（本仓库已补 /api/interpret）───
# 开源原版不含该路由；现用 MiniMax OpenAI 兼容接口做流式解读。
# 只想排盘、看命盘的话可以不填；点「AI 解读」时才需要。
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_BASE_URL=https://api.minimax.cn/v1
MINIMAX_MODEL=MiniMax-M3.1-Flash

# ─── 可选：其他 OpenAI 兼容模型（当前 interpret 路由读的是上面 MiniMax 三项）───
# AI_PROVIDER=deepseek
# DEEPSEEK_API_KEY=your-deepseek-api-key
# AI_PROVIDER=mimo
# MIMO_API_KEY=your-api-key
# MIMO_BASE_URL=https://your-provider/v1
# MIMO_MODEL=model-name

# ─── 站点 ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
